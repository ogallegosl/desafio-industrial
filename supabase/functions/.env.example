# Edge Function exam-access
# Configura este valor en Supabase Edge Function Secrets.
# Admite varios orígenes exactos separados por coma.
APP_ALLOWED_ORIGINS=https://YOUR_SITE.netlify.app

# SUPABASE_URL y las credenciales de servidor son suministradas por Supabase
# al runtime de Edge Functions. No copies claves secretas al frontend.
